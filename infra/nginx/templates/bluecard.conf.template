# Rendered at container start: the official nginx image runs envsubst on
# ${API_DOMAIN} / ${ADMIN_DOMAIN} (set in the environment). nginx's own
# variables ($host, $scheme, …) are left untouched.

# --- HTTP: ACME challenge + redirect to HTTPS --------------------------------
server {
  listen 80;
  server_name ${API_DOMAIN} ${ADMIN_DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

# --- API (api.<domain>) ------------------------------------------------------
server {
  listen 443 ssl;
  http2 on;
  server_name ${API_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  client_max_body_size 12m; # ID photos / store logos

  location / {
    proxy_pass http://api:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# --- Admin dashboard (admin.<domain>) ----------------------------------------
server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://admin:80;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
