# =============================================================================
# Blue Card — environment variables (example)
# Copy to `.env` for local dev. NEVER commit a real .env.
# All secrets are read from the environment; nothing is hardcoded.
# =============================================================================

# ----- Core API -----
NODE_ENV=development
API_PORT=3000
# Public base URL of the API (used in email/SMS deep links)
API_PUBLIC_URL=http://localhost:3000

# ----- Database (PostgreSQL) -----
# Matches infra/docker-compose.yml defaults for local dev.
POSTGRES_USER=bluecard
POSTGRES_PASSWORD=bluecard
POSTGRES_DB=bluecard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma connection string (assembled from the values above for local dev).
DATABASE_URL=postgresql://bluecard:bluecard@localhost:5432/bluecard?schema=public
# Optional dedicated shadow DB for `prisma migrate dev` (defaults to auto-created).
# SHADOW_DATABASE_URL=postgresql://bluecard:bluecard@localhost:5432/bluecard_shadow?schema=public

# ----- Redis (BullMQ queue) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Job driver: 'inline' (in-process, no Redis — dev) or 'bullmq' (Redis-backed).
QUEUE_DRIVER=inline

# ----- Tamper-check (advisory scoring) -----
# Score 0..1; status = clean | suspect | flagged. Never auto-rejects.
TAMPER_SUSPECT_THRESHOLD=0.34
TAMPER_FLAGGED_THRESHOLD=0.67

# ----- Auth / JWT / TOTP -----
# Generate strong random values, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Issuer label shown in authenticator apps for admin/root TOTP
TOTP_ISSUER=Blue Card

# ----- Root bootstrap (one-time) -----
# Used by `npm run create:root -w @blue-card/api` to create the first root admin.
# The root enrols TOTP on first login. Use a strong password (>= 12 chars).
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=change-me-strong-root-password

# ----- Object storage (ID photos) -----
# Driver: 'local' (dev only, encrypted on disk) or 's3' (S3-compatible bucket).
STORAGE_DRIVER=local
# Local driver (dev): where encrypted photos are written, plus the AES-256 key.
LOCAL_STORAGE_DIR=./var/id-photos
# 32-byte key as 64 hex chars, e.g. `openssl rand -hex 32`
STORAGE_ENCRYPTION_KEY=
# S3-compatible (R2 / B2 / S3 / MinIO). Access only via short-lived signed URLs.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=bluecard-id-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Server-side encryption at rest (provider-dependent)
S3_SSE=AES256
# How long signed ID-photo view URLs stay valid (seconds)
SIGNED_URL_TTL_SECONDS=120

# ----- Twilio -----
# Phone OTP uses Twilio Verify (Twilio manages the code lifecycle).
# If these are blank, a DEV verifier is used that accepts OTP_DEV_CODE.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Accepted code when the dev verifier is active (no Twilio creds set).
OTP_DEV_CODE=000000
# Used later for marketing SMS campaigns (raw SMS), not for OTP.
TWILIO_FROM_NUMBER=

# ----- Email provider (transactional + campaigns) -----
# One of: resend | postmark | sendgrid | ses
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Blue Card <no-reply@example.com>"

# ----- Apple Wallet (PassKit) -----
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PATH=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PATH=

# ----- Google Wallet -----
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# ----- i18n -----
DEFAULT_LOCALE=el
SUPPORTED_LOCALES=el,en
